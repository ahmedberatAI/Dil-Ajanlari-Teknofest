  "SONUC": {
    "soru": "Daha yuksek cozunurluk zayif siniflarda MCC'yi arttirdi mi?",
    "pano": {
      "cevap": "HAYIR — HIC.",
      "ayrinti": "Uc kolun UCU DE 49/49 klipte 'GORUNMUYOR' dedi. Esli karsilastirmada TEK BIR KLIP bile farkli cevaplanmadi (uyumsuz cift = 0, p=1,0). MCC tanimsiz (tahmin varyansi sifir), UC KOL DA DEJENERE. 1920 native cozunurlukte bile model panoyu HIC bulamadi -> DARBOGAZ COZUNURLUK DEGIL, CERCEVELEME/ROI.",
      "MCC_768": null,
      "MCC_1280": null,
      "MCC_1920": null,
      "delta": 0.0
    },
    "yelek": {
      "cevap": "EVET — ama 1280'de DOYUYOR.",
      "MCC_768": 0.0,
      "MCC_1280": 0.5604,
      "MCC_1920": 0.5641,
      "delta_768_1280": 0.5604,
      "delta_1280_1920": 0.0037,
      "esik": 0.15,
      "ayrinti": "768 -> 1280 gecisi on kayit esigini (+0,15) FAZLASIYLA asti: MCC 0,000 -> 0,560, dogruluk 0,500 -> 0,780 (+28 puan, GA95 [+0,127,+0,414], McNemar p=0,0013; 16 klip duzeldi, 2 bozuldu). 1280 -> 1920 gecisi ise SIFIR net kazanc: MCC +0,004 (GURULTU), 6 klip duzeldi 6 klip bozuldu, p=1,0.",
      "uyari": "768 kolu DEJENERELIK KAPISINI GECTI (en bol etiket %52) ama MCC TAM 0,000 — yani cesitli cevap veriyor, cesitlilik GERCEKLE ILGISIZ. 'Dejenere degil' = 'bilgilendirici' DEMEK DEGIL."
    },
    "TAVSIYE": "1280 KULLAN. 1920, 1280'e gore 3,8x bayt ve 2,8x gecikme maliyeti karsiliginda OLCULEBILIR SIFIR kazanc veriyor. 768 ise yelek sinifinda bilgiyi TAMAMEN kaybettiriyor.",
    "ON_KAYIT_BEKLENTIM_YANLIS_CIKTI": "On kayitta 'cozunurluk MCC'yi anlamli arttirmayacak' yazmistim. Yelek sinifinda YANILDIM (+0,56 MCC). Pano sinifinda tahminim dogruydu. BILDIRIYORUM."
  }
