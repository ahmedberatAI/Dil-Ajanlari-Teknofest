# =============================================================================
# .env ORNEGI — bunu `.env` olarak kopyalayip DEGERLERI DOLDURUN
#
#     cp .env.ornek .env
#
# `.env` .gitignore'da (7. satir) — depoya GIRMEZ. Bu ornek dosyada GERCEK
# ANAHTAR BULUNMAZ; oyle kalmalidir.
#
# Dokumantasyonun kurali: anahtar KODA GOMULMEZ, ortamdan okunur.
# =============================================================================

# --- UZAK CIKARIM SERVISI (D41, yarisma tahsisi: 8xH200, BF16) ---------------
# BOS BIRAKILIRSA yerel vLLM kullanilir (eski davranis, hicbir sey degismez).
# Doldurulursa tum model cagrilari bu adrese gider — cagri yerleri AYNI kalir.
DILAJAN_API_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
DILAJAN_API_KEY=sk-evren-teamNN-XXXXXXXX

# Dokumantasyon: istemci varsayilani 600 s YETERSIZ; 1800 s onerilir.
DILAJAN_API_TIMEOUT=1800

# --- MODEL SECIMI ------------------------------------------------------------
# Servisteki alias'lar: llm-large · llm-fast · vlm · router · guard
#   llm-large : tek cagrida video + Turkce ozet + JSON (TR-MMLU %79,6)
#   vlm       : ayrilmis hizli video (GORUNTU KABUL ETMEZ -> 400)
#   llm-fast  : belge/siniflandirma/JSON/arac cagirma (medyan 0,91 s)
# UYARI: bilinmeyen model adi 404 DONDURMEZ, sessizce llm-fast'e yonlendirilir.
#        Olcum almadan once `GET /v1/models` ile dogrulayin.
DILAJAN_MODEL_NAME=llm-large

# --- VEKTOR VERITABANI (Qdrant) — su an KULLANILMIYOR ------------------------
# Kullanilacaksa: port=443 ve prefix ZORUNLU, yoksa sessizce yanlis yere gider.
# EVREN_QDRANT_KEY=qdr-teamNN-XXXXXXXX
# EVREN_TEAM=teamNN

# --- ALTERNATIF ISIMLENDIRME -------------------------------------------------
# DIKKAT: dokumantasyonun ornekleri EVREN_* kullaniyor ama bu adlar TEK BASINA
# YETMEZ. pydantic-settings .env dosyasini yalnizca ALAN cozumlemesi icin okur,
# os.environ'a YAZMAZ; env_prefix "DILAJAN_" oldugu icin EVREN_* anahtarlari
# sessizce atilir ve sistem YEREL vLLM'e duser. Uzak servisi kullanmak icin
# YUKARIDAKI DILAJAN_API_BASE_URL / DILAJAN_API_KEY satirlari DOLU olmalidir.
# Asagidakiler yalnizca kopyala-yapistir kolayligi icindir.
# EVREN_API_KEY=sk-evren-teamNN-XXXXXXXX
# EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1

# --- GOREVE GORE MODEL (D41) -------------------------------------------------
# Bos birakilan alan DILAJAN_MODEL_NAME'e duser. Dokumantasyonun olcumlerine gore:
#   JSON + arac cagirma: llm-fast == llm-large (1,000 == 1,000) -> buyugu BOSUNA
#   bilgi isi (TR-MMLU): llm-large +6,3 puan; tarih +12 puan
#   llm-fast medyan gecikme 0,91 s
# Sistem TUM takimlarca paylasiliyor: buyuk modeli gereksiz mesgul etmeyelim.
# OLCULDU: sayma -> llm-large · kisi/oznitelik -> vlm (zit uzmanlasma)
DILAJAN_MODEL_ALGI=vlm
DILAJAN_MODEL_SAYIM=llm-large
DILAJAN_MODEL_YAPI=llm-fast
DILAJAN_MODEL_OZET=llm-large
DILAJAN_MODEL_DIYALOG=llm-large
DILAJAN_MODEL_YONLENDIRME=router
DILAJAN_MODEL_GUVENLIK=guard
DILAJAN_MODEL_GOMME=bge-m3-embed

# --- D44: SEVK EDILEN ISG YAPILANDIRMASI (149 klip uzerinde OLCULDU) --------
# Carrying_Overload_with_Forklift  MCC +0,851  (25/25 yakalandi, 0 kacirma)
# Unauthorized_Intervention        MCC +0,689
# Opened_Panel_Cover               MCC +0,960  (ayrilmis kumede +1,000)
# Kiyas — ayni klipler, eski serbest-metin boru hatti: 0/20 ISG olayi.
#
# Bu satirlar BOS birakilirsa gozlem duzlemi KAPANIR ve sistem eski
# davranisina doner (K2). Esikler TESISE OZGUDUR, baska tesiste yeniden
# kalibre edilmelidir.
# (yaya_cizgi_mesafe SEVK EDILMIYOR — gerekce dosyanin sonunda)
DILAJAN_ISG_SLOTLARI=catal_kasa_sayisi,makine_basinda_yelek,pano_koyuluk_0_10

# Pano slotunun KIRPMA bolgesi. Tam karede soru DEJENERE (MCC -0,192);
# kirpilmis ROI'de +0,960. Ayrilmis kumede dogrulandi: esik 6-7-8 platosu.
DILAJAN_PANEL_ROI_VLM=0.00,0.47,0.29,0.81
DILAJAN_PANEL_KOYULUK_ESIK=6

# YEREL PANO DEDEKTORU KAPALI (bos). Kisi kontrolu icin RT-DETRv2'yi YERELDE
# calistiriyordu (~3,5 GB VRAM, her klipte) ve 197 klipte +0,270'e dusuyordu.
# VLM slotu hem daha iyi hem tamamen uzak: yerel agirlik yuklenmesi = 0.
DILAJAN_PANEL_ROI=

# --- D45: YAYA YOLU SINIFI (dorduncu ISG sinifi) ----------------------------
# Ayrilmis kumede dogrulandi: MCC +0,638 (TP11 FP4 FN0 TN5, n=20), esik
# kocumdan ONCE secildi. Cerceveleme tabani -0,072 -> skor kamera acisindan
# GELMIYOR (geofence yaklasimi tam bu yuzden reddedilmisti).
# ROI kirpmasi ZORUNLU: tam karede ayni soru MCC +0,192.
DILAJAN_YOL_ROI_VLM=0.00,0.50,1.00,1.00
DILAJAN_YOL_MESAFE_ESIK=7

# --- D45 KARARI: YAYA YOLU SLOTU SEVK EDILMIYOR ------------------------------
# Slot CALISIYOR ve ayrilmis kumede dogrulandi (MCC +0,638, TP11 FP4 FN0 TN5).
# Uctan uca 197 klipte cift bazli MCC +0,535. AMA saha davranisi kabul edilemez:
#
#   yol kurali · forklift kliplerinde ateslemesi : 49/50   <- BASKA KAMERA
#   yol kurali · pano kliplerinde                : 46/49
#   yol kurali · yetkisiz kliplerinde            : 33/50
#   ateslenen 166 klipte gercek ihlal orani      : 0,151
#
# Hicbir esik bunu kurtarmiyor (taranan 10 esigin hepsinde genel kesinlik
# %13-15). Cift bazli MCC bu davranisi GIZLIYOR cunku kurali yalnizca kendi
# cifti icinde olcuyor; operator ise tum klipleri goruyor.
#
# Kural ve slot KODDA DURUYOR (olcum kaydi silinmez, §7). Acmak icin
# `yaya_cizgi_mesafe` slot listesine eklenir. Acilirsa ONCE sahne on kosulu
# (kamera gorus muhafizi) eklenmelidir — `dilajan/pano.py:gorus_imzasi`
# altyapisi bunun icin hazir.
#
# KIYAS — yol KAPALIYKEN kalan uc kuralin kameralar arasi sizintisi: 4/169 (%2,4)
DILAJAN_ISG_SLOTLARI=catal_kasa_sayisi,makine_basinda_yelek,pano_koyuluk_0_10
