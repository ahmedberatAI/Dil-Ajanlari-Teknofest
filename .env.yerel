# =============================================================================
# YEREL YEDEK YAPILANDIRMA — uzak servis sunum sirasinda dusiverse
#
# KULLANIM:
#     cp .env .env.uzak.yedek       # mevcut yapilandirmayi sakla
#     cp .env.yerel .env            # yerel moda gec
#     python serve_vllm.py          # AYRI terminalde
#     python app.py
#
# GERI DONUS:
#     cp .env.uzak.yedek .env
#
# NEDEN AYRI DOSYA: yalnizca base_url'i bosaltmak YETMEZ. Model ADLARI
# (llm-large/vlm/llm-fast) uzak servise aittir; yerel vLLM onlari tanimaz ve
# 404 doner. 404 KALICI hata sayildigi icin yeniden denenmez ve analiz
# sessizce bos doner. Bu dosya ALTI degiskeni birden dogru degere ceker.
# =============================================================================

# uzak servis KAPALI
DILAJAN_API_BASE_URL=
DILAJAN_API_KEY=

# yerel vLLM'in gercekten servis ettigi model
DILAJAN_MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct-FP8
DILAJAN_MODEL_ALGI=
DILAJAN_MODEL_SAYIM=
DILAJAN_MODEL_YAPI=
DILAJAN_MODEL_OZET=
DILAJAN_MODEL_DIYALOG=
DILAJAN_MODEL_YONLENDIRME=
DILAJAN_MODEL_GUVENLIK=
DILAJAN_MODEL_GOMME=

# ISG gozlem duzlemi — yerelde de calisir (esikler ayni tesise ait)
DILAJAN_ISG_SLOTLARI=catal_kasa_sayisi,makine_basinda_yelek,pano_koyuluk_0_10
DILAJAN_PANEL_ROI_VLM=0.00,0.47,0.29,0.81
DILAJAN_PANEL_KOYULUK_ESIK=6
DILAJAN_PANEL_ROI=
DILAJAN_KODLAMA_NORMALIZE=1
DILAJAN_KODLAMA_FPS=8
DILAJAN_KODLAMA_BIT=800k

# yerelde GPU kullanmak ZORUNLU (uzak servis yok)
DILAJAN_YEREL_GPU_IZNI=1
